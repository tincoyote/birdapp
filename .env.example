# Copy this file to .env and fill in real values. .env itself is gitignored
# and never committed - this example file is the only credentials-shaped
# thing that lives in git.
ADMIN_USERNAME=changeme
ADMIN_PASSWORD=changeme

# Optional second credential pair for scripts/automation (e.g. the
# SpeciesNet second-opinion runner). Leave both blank/unset to disable this
# path entirely - unlike ADMIN_* above, there is no "changeme" fallback,
# since an unset pair should mean disabled, not insecure-default-enabled.
API_USERNAME=
API_PASSWORD=
